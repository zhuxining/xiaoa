{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "bun run check && bun run check-types && bunx markdownlint-cli2 --fix .",
						"timeout": 30
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"security-guidance@claude-plugins-official": true,
		"feature-dev@claude-plugins-official": true,
		"code-simplifier@claude-plugins-official": true,
		"code-review@claude-plugins-official": true
	},
	"permissions": {
		"allow": ["Bash(bun)", "Bash(git)", "Bash(cd)", "Bash(ls)", "Bash(cat)"]
	}
}
