{
	"name": "xiaoa",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*"
		],
		"catalog": {
			"react": "^19.1.0",
			"react-dom": "^19.1.0",
			"@types/react": "^19.1.5",
			"@types/react-dom": "^19.1.5",
			"typescript": "^6.0.0-beta",
			"clsx": "^2.1.1",
			"tailwind-merge": "^3.3.1",
			"tailwindcss": "^4.1.7",
			"@tailwindcss/vite": "^4.1.7",
			"vite": "^8.0.0-beta.14",
			"@vitejs/plugin-react": "^5.1.4",
			"jotai": "^2.12.3",
			"class-variance-authority": "^0.7.1",
			"lucide-react": "^0.563.0",
			"@radix-ui/react-slot": "^1.2.3"
		}
	},
	"scripts": {
		"dev": "bun run --filter '@xiaoa/electron' dev",
		"build": "bun run --filter '@xiaoa/electron' build",
		"make": "bun run --filter '@xiaoa/electron' make",
		"clean": "git clean -xdf",
		"check": "biome check --write --unsafe",
		"check-types": "bun run --filter '*' typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@typescript/native-preview": "^7.0.0-dev.20260212.1",
		"typescript": "^6.0.0-dev.20260212"
	}
}
